{
  "name": "@shafaqshaikh/react-native-ota-updates",
  "version": "0.1.0",
  "description": "Self-hosted OTA updates for React Native — MongoDB + any S3-compatible storage (R2, S3, MinIO). Multi-tenant, staged rollouts, crash-loop rollback, same-launch delivery.",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./app.plugin": "./app.plugin.js",
    "./plugin/*": "./plugin/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "ota-updates": "./cli/index.js"
  },
  "files": [
    "src",
    "lib",
    "cli",
    "android",
    "ios",
    "plugin",
    "app.plugin.js",
    "react-native-ota-updates.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "server": "cd server && npm install && npm start",
    "server:dev": "cd server && npm install && npm run dev"
  },
  "keywords": [
    "react-native",
    "ota",
    "updates",
    "over-the-air",
    "code-push",
    "expo-updates",
    "self-hosted",
    "mongodb",
    "cloudflare-r2",
    "s3",
    "hermes"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/your-org/react-native-ota-updates#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/react-native-ota-updates.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/react-native-ota-updates/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/react-native": "^0.72.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
