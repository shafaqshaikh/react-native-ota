# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── MongoDB ───────────────────────────────────────────────────────
# Any MongoDB URI (Atlas, self-hosted, docker compose)
MONGO_URL=mongodb://mongo:27017/ota-updates

# ── Object storage (S3-compatible) ────────────────────────────────
# Works with Cloudflare R2, AWS S3, Backblaze B2, Wasabi, MinIO, etc.
# R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# AWS S3 example:
#   S3_ENDPOINT=
#   S3_REGION=us-east-1
# MinIO example:
#   S3_ENDPOINT=http://minio:9000
#   S3_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ota-bundles
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Public URL prefix that devices use to download bundles.
# For R2, either your custom domain (https://bundles.example.com)
# or the r2.dev public URL when you enable public access.
# For self-hosted MinIO: http://localhost:9000/ota-bundles
S3_PUBLIC_BASE_URL=https://bundles.example.com

# ── Admin dashboard (Basic Auth) ──────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-immediately
